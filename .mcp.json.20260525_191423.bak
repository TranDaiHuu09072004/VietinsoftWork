{
  "mcpServers": {
    "mssql-vietinsoft": {
      "command": "npx",
      "args": [
        "-y",
        "@bilims/mcp-sqlserver"
      ],
      "env": {
        "SQLSERVER_HOST": "${MSSQL_SERVER}",
        "SQLSERVER_PORT": "${MSSQL_PORT}",
        "SQLSERVER_USER": "${MSSQL_USER}",
        "SQLSERVER_PASSWORD": "${MSSQL_PASSWORD}",
        "SQLSERVER_DATABASE": "${MSSQL_DATABASE}"
      }
    },
    "Paradise_Dev": {
      "command": "npx",
      "args": [
        "-y",
        "@bilims/mcp-sqlserver"
      ],
      "env": {
        "SQLSERVER_HOST": "192.168.11.51",
        "SQLSERVER_PORT": "2222",
        "SQLSERVER_USER": "vts.sa",
        "SQLSERVER_PASSWORD": "LuaThieng1@3@2020",
        "SQLSERVER_DATABASE": "Paradise_Dev"
      }
    },
    "DBLocal": {
      "command": "npx",
      "args": [
        "-y",
        "@executeautomation/database-server",
        "--sqlserver",
        "--server",
        ".\\sqlexpress",
        "--port",
        "1433",
        "--database",
        "Paradise_HPSF",
        "--user",
        "sa",
        "--password",
        "LuaThieng1@3@2020"
      ]
    }
  }
}
