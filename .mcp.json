{
  "mcpServers": {
    "mssql-vietinsoft": {
      "command": "npx",
      "args": [
        "-y",
        "@bilims/mcp-sqlserver"
      ],
      "env": {
        "SQLSERVER_HOST": "${MSSQL_SERVER}",
        "SQLSERVER_PORT": "${MSSQL_PORT}",
        "SQLSERVER_USER": "${MSSQL_USER}",
        "SQLSERVER_PASSWORD": "${MSSQL_PASSWORD}",
        "SQLSERVER_DATABASE": "${MSSQL_DATABASE}"
      }
    },
