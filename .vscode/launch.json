{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch Chrome (Localhost)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:8080", // Thay đổi cổng hoặc địa chỉ URL của dự án web nếu cần
      "webRoot": "${workspaceFolder}"
    },
    {
      "name": "Attach to Chrome",
      "type": "chrome",
      "request": "attach",
      "port": 9222,
      "webRoot": "${workspaceFolder}"
    },
    {
      "name": "Launch Edge (Localhost)",
      "type": "msedge",
      "request": "launch",
      "url": "http://localhost:8080",
      "webRoot": "${workspaceFolder}"
    }
  ]
}
